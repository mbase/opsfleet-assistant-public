# Copy to .env and supply your own values. Never commit .env.
GEMINI_API_KEY=replace-with-your-key
# BigQuery billing project ID, not its numeric project number or projects/NUMBER.
GOOGLE_CLOUD_PROJECT=your-billing-project-id
# The public thelook_ecommerce dataset is in US.
BQ_LOCATION=US
# BigQuery uses separate ADC authentication: gcloud auth application-default login.
# Gemini/OpenRouter API keys do not authenticate BigQuery.
GEMINI_MODEL=gemini-3.8-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.8-flash
